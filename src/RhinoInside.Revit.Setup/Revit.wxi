                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{7346B4A0-2300-0510-0000-705C0D862004}"
                      Name="InstallLocation"/>
    </Property>

    <Property Id="REVIT2024_INSTALLLOCATION" Secure="yes">
      <RegistrySearch Id="Revit2024InstallLocation" Type="raw"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{7346B4A0-2400-0510-0000-705C0D862004}"
                      Name="InstallLocation"/>
    </Property>

    <Property Id="REVIT2025_INSTALLLOCATION" Secure="yes">
      <RegistrySearch Id="Revit2025InstallLocation" Type="raw"
